<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.sidestage" path="/org/gnome/shell/extensions/sidestage/">
    <key name="card-width" type="i">
      <range min="120" max="280"/>
      <default>180</default>
      <summary>Thumbnail width (px)</summary>
    </key>
    <key name="max-cards" type="i">
      <range min="3" max="15"/>
      <default>8</default>
      <summary>Maximum thumbnails per monitor</summary>
    </key>
    <key name="side" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'left'</default>
      <summary>Screen side for the thumbnails</summary>
    </key>
    <key name="all-monitors" type="b">
      <default>true</default>
      <summary>Each monitor shows its own minimized windows</summary>
      <description>When off, all thumbnails go to the primary monitor.</description>
    </key>
    <key name="tilt" type="i">
      <range min="0" max="25"/>
      <default>0</default>
      <summary>3D tilt of the thumbnails (degrees)</summary>
    </key>
    <key name="middle-click-close" type="b">
      <default>true</default>
      <summary>Middle-clicking a thumbnail closes the window</summary>
    </key>
  </schema>
</schemalist>
