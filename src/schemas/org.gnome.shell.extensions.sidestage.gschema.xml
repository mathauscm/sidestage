<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.sidestage" path="/org/gnome/shell/extensions/sidestage/">
    <key name="card-width" type="i">
      <range min="120" max="280"/>
      <default>180</default>
      <summary>Largura das miniaturas (px)</summary>
    </key>
    <key name="max-cards" type="i">
      <range min="3" max="15"/>
      <default>8</default>
      <summary>Máximo de miniaturas por monitor</summary>
    </key>
    <key name="side" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'left'</default>
      <summary>Lado da tela onde ficam as miniaturas</summary>
    </key>
    <key name="all-monitors" type="b">
      <default>true</default>
      <summary>Cada monitor mostra as próprias janelas minimizadas</summary>
      <description>Desligado: todas as miniaturas ficam só no monitor principal.</description>
    </key>
    <key name="tilt" type="i">
      <range min="0" max="25"/>
      <default>0</default>
      <summary>Inclinação 3D das miniaturas (graus)</summary>
    </key>
    <key name="middle-click-close" type="b">
      <default>true</default>
      <summary>Clique do meio na miniatura fecha a janela</summary>
    </key>
  </schema>
</schemalist>
