# Local Sidestage package. Build it with "make package" from the project root.
pkgname=gnome-shell-extension-sidestage
pkgver=1.0.0
pkgrel=1
pkgdesc="macOS Stage Manager-style thumbnails for minimized windows (GNOME 51)"
arch=('any')
url="https://github.com/mathauscm/sidestage"
license=('GPL-3.0-or-later')
depends=('gnome-shell>=1:51' 'gnome-shell<1:52')
makedepends=('make')

package() {
    make -C "$startdir/.." DESTDIR="$pkgdir" install-system
}
